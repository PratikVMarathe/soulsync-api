# Local Development Environment Template
NODE_ENV=development

# Server Port for Local Running
PORT=5003

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5001,http://localhost:5002,http://localhost:5003,http://localhost:5173,https://soulsync-b29c8.web.app,https://soulsync-b29c8.firebaseapp.com

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=soulsync_images

# Maximum Image Upload Size in KB (Default: 500)
MAX_IMAGE_SIZE_KB=500

# Firebase Configuration
FIREBASE_PROJECT_ID=soulsync-b29c8
# Option 1: Inline Service Account JSON string or base64 string
FIREBASE_SERVICE_ACCOUNT=
# Option 2: Path to Service Account JSON file (for local development)
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
