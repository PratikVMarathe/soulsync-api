# Server Port
PORT=5003

# Allowed CORS Origins (comma-separated for multiple origins)
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5002,https://soulsync-b29c8.web.app,https://soulsync-b29c8.firebaseapp.com,https://soulsync-prod-app.web.app,https://soulsync-prod-app.firebaseapp.com

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=soulsync_images

# Maximum Image Upload Size in KB (Default: 500)
MAX_IMAGE_SIZE_KB=500

# Firebase Configuration
FIREBASE_PROJECT_ID=soulsync-b29c8
# Option 1: Inline Service Account JSON string or base64 string
FIREBASE_SERVICE_ACCOUNT=
# Option 2: Path to Service Account JSON file (for local development)
FIREBASE_SERVICE_ACCOUNT_PATH=
